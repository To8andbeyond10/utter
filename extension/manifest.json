{
  "manifest_version": 3,
  "name": "Clearband",
  "short_name": "Clearband",
  "version": "0.1.0",
  "description": "See what's AI in your feed. Flags AI-made posts on YouTube, TikTok, Instagram, X, Facebook, Threads and Reddit, with the evidence.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clearband",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/shared/settings.js", "src/background.js"]
  },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*", "https://m.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*",
        "https://www.facebook.com/*", "https://m.facebook.com/*", "https://web.facebook.com/*",
        "https://www.threads.net/*", "https://www.threads.com/*",
        "https://www.reddit.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/sites.js",
        "src/content/detect.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "clearband-beta@clearband.extension", "strict_min_version": "121.0" }
  }
}
